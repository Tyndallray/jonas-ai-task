# Copy to .env.local and fill in values from your Cognito User Pool.
# Cognito console -> User pools -> <pool> -> App integration / App clients

# Issuer URL: https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# App client ID (public client, no client secret)
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Managed login / Hosted UI domain (used for logout)
VITE_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# Must exactly match an "Allowed callback URL" on the app client
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
# Must exactly match an "Allowed sign-out URL" on the app client
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPES=openid email profile

# Backend API; requests get "Authorization: Bearer <access token JWT>"
VITE_API_BASE_URL=http://localhost:3000
