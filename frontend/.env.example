# Copy to .env.local and fill in values from the backend stack outputs
# (`npm run info` in backend/, or CloudFormation -> jonas-ai-task-backend-dev -> Outputs)

# --- User pool (self-signup) ---
# Issuer URL: UserPoolAuthority output, https://cognito-idp.<region>.amazonaws.com/<userPoolId>
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# App client ID (UserPoolClientId output; public client, no client secret)
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Managed login domain (UserPoolDomainUrl output; used for logout)
VITE_COGNITO_DOMAIN=https://jonas-ai-task-backend-users-dev.auth.us-east-1.amazoncognito.com
# Must exactly match an "Allowed callback URL" on the app client
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
# Must exactly match an "Allowed sign-out URL" on the app client
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPES=openid email profile

# --- Admin pool (no signup; admins are created by an operator) ---
VITE_ADMIN_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YYYYYYYYY
VITE_ADMIN_COGNITO_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy
VITE_ADMIN_COGNITO_DOMAIN=https://jonas-ai-task-backend-admins-dev.auth.us-east-1.amazoncognito.com
VITE_ADMIN_COGNITO_REDIRECT_URI=http://localhost:5173/admin
VITE_ADMIN_COGNITO_LOGOUT_URI=http://localhost:5173/admin

# Backend API (ServiceEndpoint, e.g. https://xxxx.execute-api.us-east-1.amazonaws.com/dev);
# requests get "Authorization: Bearer <ID token JWT>"
VITE_API_BASE_URL=http://localhost:3000
